<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#102a4c">
    <meta name="description" content="Publicaciones y notas de Node Blog.">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header class="site-header">
        <nav class="site-nav" aria-label="Navegación principal">
            <a class="brand" href="/" aria-label="Node Blog, inicio">Node Blog</a>
            <div class="nav-links">
                <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>" <%= currentPath === '/' ? 'aria-current="page"' : '' %>>Home</a>
                <a href="/profiles" class="<%= currentPath.startsWith('/profiles') ? 'active' : '' %>" <%= currentPath.startsWith('/profiles') ? 'aria-current="page"' : '' %>>Perfiles</a>
                <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>" <%= currentPath === '/about' ? 'aria-current="page"' : '' %>>Sobre nosotros</a>
                <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>" <%= currentPath === '/contact' ? 'aria-current="page"' : '' %>>Contacta con nosotros</a>
            </div>
            <div class="nav-account">
                <% if (user) { %>
                    <a class="nav-create" href="/posts/create">Crear post</a>
                    <% if (user.role === 'ADMIN') { %>
                        <a class="nav-admin" href="/admin" <%= currentPath.startsWith('/admin') ? 'aria-current="page"' : '' %>>Administración</a>
                        <span class="nav-greeting nav-greeting-admin" aria-label="Administrador: <%= user.name %>">
                            <span class="nav-admin-avatar" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" />
                                </svg>
                            </span>
                            <span class="nav-admin-identity">
                                <span class="nav-admin-name"><%= user.name %></span>
                                <span class="nav-admin-badge">ADMIN</span>
                            </span>
                        </span>
                    <% } else { %>
                        <span class="nav-greeting">Hola, <%= user.name %></span>
                    <% } %>
                    <form action="/auth/logout" method="POST">
                        <button class="nav-login" type="submit">Cerrar sesión</button>
                    </form>
                <% } else { %>
                    <a class="nav-login" href="/auth/login">Iniciar sesión</a>
                    <a class="nav-register" href="/auth/register">Registrarse</a>
                <% } %>
            </div>
        </nav>
    </header>
    <main>