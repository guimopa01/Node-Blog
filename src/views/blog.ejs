<%- include('partials/header') %>

    <section class="page-width page-heading-row">
        <div>
            <p class="eyebrow">BLOG</p>
            <h1>Todos los posts</h1>
        </div>
        <% if (user) { %>
            <a class="button" href="/posts/create">Crear post</a>
        <% } else { %>
            <a class="button button-outline" href="/auth/login">Inicia sesión para publicar</a>
        <% } %>
    </section>

    <div class="feed-layout page-width">
        <section class="feed-main">
            <div class="feed-heading">
                <h2>Publicaciones</h2>
                <span><%= posts.length %> <%= posts.length === 1 ? 'post' : 'posts' %></span>
            </div>
            <% if (posts.length) { %>
                <div class="post-card-list">
                    <% posts.forEach((post) => { %>
                        <%- include('partials/post-card', { post }) %>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="empty-posts">Todavía no hay posts publicados.</p>
            <% } %>
        </section>
        <%- include('partials/recent-posts', { recentPosts }) %>
    </div>

<%- include('partials/footer') %>
