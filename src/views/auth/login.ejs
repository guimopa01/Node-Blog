<%- include('../partials/header') %>

    <section class="auth-page">
        <div class="auth-card">
            <p class="eyebrow"><span class="eyebrow-dot"></span> QUÉ BUENO TENERTE DE VUELTA</p>
            <h1>Inicia sesión.</h1>
            <p class="auth-intro">Entra para seguir compartiendo buenas ideas.</p>

            <% if (authRequired) { %>
                <p class="auth-required-note" role="status">Inicia sesión para participar. Después volverás a la publicación.</p>
            <% } %>
            <% if (blocked) { %>
                <p class="form-error" role="alert">Tu sesión se ha cerrado porque esta cuenta está bloqueada.</p>
            <% } %>
            <% if (registered) { %>
                <p class="form-success" role="status">Tu cuenta está lista. Ya puedes iniciar sesión.</p>
            <% } %>
            <% if (error) { %>
                <p class="form-error" role="alert"><%= error %></p>
            <% } %>

            <form action="/auth/login" method="POST" class="auth-form">
                <% if (returnTo !== '/') { %>
                    <input type="hidden" name="returnTo" value="<%= returnTo %>">
                <% } %>
                <label for="email">Correo electrónico</label>
                <input id="email" type="email" name="email" autocomplete="email" required>

                <label for="password">Contraseña</label>
                <input id="password" type="password" name="password" autocomplete="current-password" required>

                <button class="button button-dark" type="submit">Iniciar sesión <span aria-hidden="true">↗</span></button>
            </form>
            <p class="auth-switch">¿Aún no tienes cuenta? <a href="/auth/register<%= returnTo !== '/' ? '?returnTo=' + encodeURIComponent(returnTo) : '' %>">Crea una aquí</a></p>
        </div>
    </section>

<%- include('../partials/footer') %>