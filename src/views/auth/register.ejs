<%- include('../partials/header') %>

    <section class="auth-page">
        <div class="auth-card">
            <p class="eyebrow"><span class="eyebrow-dot"></span> BIENVENIDO A NODE BLOG</p>
            <h1>Crea tu cuenta.</h1>
            <p class="auth-intro">Únete a la conversación y comparte tus ideas.</p>

            <% if (authRequired) { %>
                <p class="auth-required-note" role="status">Crea tu cuenta para participar. Después podrás iniciar sesión y volver a la publicación.</p>
            <% } %>
            <% if (error) { %>
                <p class="form-error" role="alert"><%= error %></p>
            <% } %>

            <form action="/auth/register" method="POST" class="auth-form">
                <% if (returnTo !== '/') { %>
                    <input type="hidden" name="returnTo" value="<%= returnTo %>">
                <% } %>
                <label for="name">Nombre</label>
                <input id="name" type="text" name="name" autocomplete="name" minlength="2" required>

                <label for="email">Correo electrónico</label>
                <input id="email" type="email" name="email" autocomplete="email" required>

                <label for="password">Contraseña</label>
                <input id="password" type="password" name="password" autocomplete="new-password" minlength="8" maxlength="72" required>
                <small class="field-hint">Usa al menos 8 caracteres.</small>

                <button class="button button-dark" type="submit">Crear cuenta <span aria-hidden="true">↗</span></button>
            </form>
            <p class="auth-switch">¿Ya tienes una cuenta? <a href="/auth/login<%= returnTo !== '/' ? '?returnTo=' + encodeURIComponent(returnTo) : '' %>">Inicia sesión</a></p>
        </div>
    </section>

<%- include('../partials/footer') %>
