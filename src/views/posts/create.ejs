<%- include('../partials/header') %>

    <section class="content-page page-width">
        <a class="back-link" href="/blog">← Volver al blog</a>
        <div class="page-heading create-heading">
            <p class="eyebrow">NUEVA PUBLICACIÓN</p>
            <h1>Crear post</h1>
        </div>

        <% if (error) { %>
            <p class="form-error" role="alert"><%= error %></p>
        <% } %>

        <form class="create-post-form" action="/posts/create" method="POST" enctype="multipart/form-data">
            <label>
                <span>Título</span>
                <input type="text" name="title" maxlength="160" required>
            </label>
            <label>
                <span>Categoría <small>(opcional)</small></span>
                <select name="categoryId">
                    <option value="">Sin categoría</option>
                    <% categories.forEach((category) => { %>
                        <option value="<%= category.id %>"><%= category.name %></option>
                    <% }) %>
                </select>
            </label>
            <label>
                <span>Imagen <small>(opcional, máximo 5 MB)</small></span>
                <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif">
            </label>
            <label>
                <span>Contenido</span>
                <textarea name="content" rows="12" maxlength="20000" required></textarea>
            </label>
            <button type="submit">Publicar post</button>
        </form>
    </section>

<%- include('../partials/footer') %>
