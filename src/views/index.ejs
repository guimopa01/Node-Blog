<%- include('partials/header') %>

    <h1>Bienvenido a mi Blog 🚀</h1>
    <hr>

    <% if (posts.length===0) { %>
        <p>Aún no hay publicaciones en el blog.</p>
        <% } else { %>
            <div class="posts-container">
                <% posts.forEach(post=> { %>
                    <article style="margin-bottom: 30px; border-bottom: 1px solid #ddd; padding-bottom: 15px;">
                        <h2>
                            <%= post.title %>
                        </h2>
                        <p style="color: #666; font-size: 0.9rem;">
                            Por <strong>
                                <%= post.author.name %>
                            </strong> |
                            Categoría: <span style="background: #e2e8f0; padding: 2px 6px; border-radius: 4px;">
                                <%= post.category.name %>
                            </span> |
                            Publicado el: <%= new Date(post.createdAt).toLocaleDateString() %>
                        </p>
                        <p>
                            <%= post.content.substring(0, 200) %>...
                        </p>
                        <a href="/posts/<%= post.id %>">Leer más</a>
                    </article>
                    <% }) %>
            </div>
            <% } %>

                <%- include('partials/footer') %>