<%- include('partials/header') %>

    <section class="home-intro page-width">
        <p class="eyebrow">NODE BLOG</p>
        <h1>Posts, ideas y conversaciones.</h1>
        <p>Lee las últimas publicaciones o entra al blog para verlas todas.</p>
    </section>

    <section class="home-image-grid page-width" aria-label="Imágenes de las publicaciones">
        <% posts.forEach((post) => { %>
            <a class="home-image-link" href="/posts/<%= post.id %>" aria-label="Ver publicación: <%= post.title %>">
                <% if (post.images.length) { %>
                    <img src="<%= post.images[0].url %>" alt="<%= post.title %>" loading="lazy">
                <% } else { %>
                    <div class="home-image-placeholder" aria-hidden="true">Node Blog</div>
                <% } %>
            </a>
        <% }) %>
    </section>

<%- include('partials/footer') %>
