<%- include('partials/header') %>

    <section class="home-intro page-width">
        <p class="eyebrow">NODE BLOG</p>
        <h1>Blogs, ideas y conversaciones.</h1>
        <p>Descubre las publicaciones más recientes y conoce a sus autores en Perfiles.</p>
    </section>

    <div class="feed-layout page-width">
        <section class="feed-main">
            <div class="feed-heading">
                <h2>Últimas publicaciones</h2>
                <a href="/blog">Ver todas</a>
            </div>
            <% if (posts.length) { %>
                <div class="post-card-list">
                    <% posts.forEach((post) => { %>
                        <%- include('partials/post-card', { post }) %>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="empty-posts">Todavía no hay publicaciones.</p>
            <% } %>
        </section>
        <%- include('partials/recent-posts', { recentPosts }) %>
    </div>

<%- include('partials/footer') %>
